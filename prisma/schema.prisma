generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                 @id @default(cuid())
  name                          String?
  email                         String?                @unique
  emailVerified                 DateTime?
  image                         String?
  passwordHash                  String?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  role                          String                 @default("USER")
  accounts                      Account[]
  books                         Book[]
  bookOrders                    BookOrder[]
  aiProductionRuns              AIBookProductionRun[]  @relation("AIBookProductionAuthor")
  approvedAIProductionRuns      AIBookProductionRun[]  @relation("AIBookProductionApprover")
  orderAuditLogs                BookOrderAuditLog[]
  familyMemberships             FamilyMember[]
  memories                      Memory[]
  passwordResetTokens           PasswordResetToken[]
  sessions                      Session[]
  timeCapsules                  TimeCapsule[]
  ProductApplication            ProductApplication[]
  BookOrderProofReview          BookOrderProofReview[] @relation("BookOrderProofReviewAuthor")
  resolvedBookOrderProofReviews BookOrderProofReview[] @relation("BookOrderProofReviewResolver")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model BookProductionRequest {
  id        String                  @id @default(cuid())
  bookId    String
  authorId  String
  name      String?
  phone     String?
  email     String?
  message   String?
  status    ProductionRequestStatus @default(REQUESTED)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  bookOrder BookOrder?

  @@index([bookId])
  @@index([authorId])
  @@index([status])
  @@map("book_production_requests")
}

model ProductApplication {
  id                 String                  @id @default(cuid())
  userId             String
  productCode        String
  productName        String
  category           String
  billingType        String
  price              Int
  name               String?
  phone              String?
  email              String?
  message            String?
  addonCodes         Json?
  adminNote          String?
  adminNoteUpdatedAt DateTime?
  status             ProductionRequestStatus @default(REQUESTED)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productCode])
  @@index([status])
  @@index([createdAt])
  @@map("product_applications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Family {
  id           String             @id @default(cuid())
  name         String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  invitations  FamilyInvitation[]
  members      FamilyMember[]
  memories     Memory[]
  timeCapsules TimeCapsule[]

  @@map("families")
}

model FamilyMember {
  id       String     @id @default(cuid())
  familyId String
  userId   String
  role     FamilyRole @default(VIEWER)
  joinedAt DateTime   @default(now())
  family   Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@map("family_members")
}

model Memory {
  id           String       @id @default(cuid())
  type         MemoryType
  title        String?
  description  String?
  fileUrl      String?
  occurredAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  authorId     String
  familyId     String?
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  family       Family?      @relation(fields: [familyId], references: [id])
  bookMemories BookMemory[]

  @@index([authorId, occurredAt])
  @@map("memories")
}

model Book {
  id              String     @id @default(cuid())
  authorId        String
  type            BookType
  title           String
  subtitle        String?
  summary         String?
  content         String?
  coverText       String?
  status          BookStatus @default(DRAFT)
  pageCount       Int?
  basedPhotoCount Int?
  basedStoryCount Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  author           User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  bookMemories     BookMemory[]
  bookOrders       BookOrder[]
  bookRevisions    BookRevision[]
  aiProductionRuns AIBookProductionRun[]

  @@index([authorId])
  @@map("books")
}

model BookOrder {
  id                  String          @id @default(cuid())
  productionRequestId String          @unique
  bookId              String
  authorId            String
  productType         BookProductType
  productName         String
  specification       String?
  quantity            Int             @default(1)
  productAmount       Int
  shippingFee         Int             @default(0)
  totalAmount         Int
  status              BookOrderStatus @default(READY)
  orderId             String          @unique
  paymentKey          String?         @unique
  paymentMethod       String?
  paidAt              DateTime?
  canceledAt          DateTime?

  productionStage          BookProductionStage @default(PREPARING)
  productionStageUpdatedAt DateTime            @default(now())
  manuscriptReceivedAt     DateTime?
  reviewStartedAt          DateTime?
  proofFileUrl             String?
  proofSentAt              DateTime?
  proofApprovedAt          DateTime?
  printOrderedAt           DateTime?
  printingCompletedAt      DateTime?

  recipientName    String?
  recipientPhone   String?
  postalCode       String?
  shippingAddress1 String?
  shippingAddress2 String?
  shippingMemo     String?
  shippingCarrier  String?
  trackingNumber   String?
  shippedAt        DateTime?
  completedAt      DateTime?
  productionNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionRequest BookProductionRequest  @relation(fields: [productionRequestId], references: [id], onDelete: Cascade)
  book              Book                   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author            User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  auditLogs         BookOrderAuditLog[]
  proofReviews      BookOrderProofReview[]
  aiProductionRuns  AIBookProductionRun[]

  manualPrintJob BookOrderManualPrintJob?

  @@index([bookId])
  @@index([authorId])
  @@index([status])
  @@index([productionStage])
  @@index([trackingNumber])
  @@map("book_orders")
}

model BookOrderProofReview {
  id           String    @id @default(cuid())
  orderId      String    @map("order_id")
  authorId     String    @map("author_id")
  proofFileUrl String    @map("proof_file_url")
  proofSentAt  DateTime  @map("proof_sent_at")
  responseType String    @map("response_type")
  message      String?
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  order      BookOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author     User      @relation("BookOrderProofReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  resolvedBy User?     @relation("BookOrderProofReviewResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([orderId, proofSentAt])
  @@index([orderId, createdAt])
  @@index([authorId, createdAt])
  @@index([resolvedById])
  @@index([responseType, resolvedAt])
  @@map("book_order_proof_reviews")
}

model BookOrderManualPrintJob {
  id                   String    @id @default(cuid())
  orderId              String    @unique @map("order_id")
  status               String    @default("PREPARING")
  printerName          String?   @map("printer_name")
  contactName          String?   @map("contact_name")
  contactPhone         String?   @map("contact_phone")
  contactEmail         String?   @map("contact_email")
  orderMethod          String?   @map("order_method")
  finalPdfUrl          String?   @map("final_pdf_url")
  coverPdfUrl          String?   @map("cover_pdf_url")
  interiorPdfUrl       String?   @map("interior_pdf_url")
  trimSize             String?   @map("trim_size")
  pageCount            Int?      @map("page_count")
  coverPaper           String?   @map("cover_paper")
  innerPaper           String?   @map("inner_paper")
  bindingType          String?   @map("binding_type")
  printColor           String?   @map("print_color")
  quantity             Int?
  unitCost             Int?      @map("unit_cost")
  totalCost            Int?      @map("total_cost")
  orderSentAt          DateTime? @map("order_sent_at")
  acceptedAt           DateTime? @map("accepted_at")
  expectedCompletionAt DateTime? @map("expected_completion_at")
  printingStartedAt    DateTime? @map("printing_started_at")
  completedAt          DateTime? @map("completed_at")
  note                 String?
  createdById          String?   @map("created_by_id")
  updatedById          String?   @map("updated_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  order BookOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([printerName, updatedAt])
  @@index([expectedCompletionAt])
  @@map("book_order_manual_print_jobs")
}

model AIBookProductionRun {
  id          String                 @id @default(cuid())
  bookId      String                 @map("book_id")
  orderId     String?                @map("order_id")
  authorId    String                 @map("author_id")
  mode        AIBookProductionMode   @default(AUTOMATIC)
  status      AIBookProductionStatus @default(QUEUED)
  currentStep AIBookProductionStep   @default(MATERIAL_ANALYSIS) @map("current_step")
  attempt     Int                    @default(1)

  sourceSnapshot     Json  @map("source_snapshot")
  outlineData        Json? @map("outline_data")
  manuscriptData     Json? @map("manuscript_data")
  photoSelectionData Json? @map("photo_selection_data")
  layoutData         Json? @map("layout_data")
  qualityReport      Json? @map("quality_report")

  finalPdfUrl         String? @map("final_pdf_url")
  requiresHumanReview Boolean @default(false) @map("requires_human_review")
  humanReviewReason   String? @map("human_review_reason")
  adminDecisionNote   String? @map("admin_decision_note")
  approvedById        String? @map("approved_by_id")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  book       Book                    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order      BookOrder?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  author     User                    @relation("AIBookProductionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  approvedBy User?                   @relation("AIBookProductionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  issues     AIBookProductionIssue[]

  @@unique([bookId, attempt])
  @@index([orderId])
  @@index([authorId, createdAt])
  @@index([approvedById])
  @@index([status, currentStep, createdAt])
}

model AIBookProductionIssue {
  id              String                        @id @default(cuid())
  runId           String                        @map("run_id")
  category        String
  code            String
  severity        AIBookProductionIssueSeverity
  status          AIBookProductionIssueStatus   @default(OPEN)
  message         String
  sourceRef       String?                       @map("source_ref")
  suggestedAction String?                       @map("suggested_action")
  confidence      Float?
  details         Json?
  resolvedAt      DateTime?                     @map("resolved_at")
  createdAt       DateTime                      @default(now()) @map("created_at")

  run AIBookProductionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status, severity])
  @@index([status, severity, createdAt])
  @@map("ai_book_production_issues")
}

model BookOrderAuditLog {
  id                String   @id @default(cuid())
  orderId           String   @map("order_id")
  actorId           String?  @map("actor_id")
  actorName         String?  @map("actor_name")
  actorEmail        String?  @map("actor_email")
  source            String
  category          String
  action            String
  summary           String
  beforeData        Json     @map("before_data")
  afterData         Json     @map("after_data")
  changedFields     Json     @map("changed_fields")
  isCustomerVisible Boolean  @default(false) @map("is_customer_visible")
  createdAt         DateTime @default(now()) @map("created_at")

  order BookOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
  @@index([category, createdAt])
  @@index([source, createdAt])
  @@index([isCustomerVisible, createdAt])
  @@map("book_order_audit_logs")
}

model BookRevision {
  id        String   @id @default(cuid())
  bookId    String
  authorId  String
  title     String
  subtitle  String?
  summary   String?
  content   String?
  coverText String?
  pageCount Int?
  label     String?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt])
  @@index([bookId, isPinned, createdAt])
  @@index([authorId])
  @@map("book_revisions")
}

model BookMemory {
  id        String   @id @default(cuid())
  bookId    String
  memoryId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([bookId, memoryId])
  @@index([bookId])
  @@index([memoryId])
  @@map("book_memories")
}

model FamilyInvitation {
  id        String     @id @default(cuid())
  familyId  String
  email     String
  role      FamilyRole @default(VIEWER)
  token     String     @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("family_invitations")
}

model TimeCapsule {
  id        String        @id @default(cuid())
  title     String
  message   String
  fileUrl   String?
  openAt    DateTime
  status    CapsuleStatus @default(LOCKED)
  openedAt  DateTime?
  isPrivate Boolean       @default(false)
  authorId  String
  familyId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  family    Family?       @relation(fields: [familyId], references: [id])

  @@index([authorId, openAt])
  @@map("time_capsules")
}

enum FamilyRole {
  OWNER
  EDITOR
  VIEWER
}

enum MemoryType {
  PHOTO
  VIDEO
  AUDIO
  TEXT
}

enum BookType {
  LIFE_BOOK
  FAMILY_BOOK
  COUPLE_BOOK
  BABY_BOOK
  TRAVEL_BOOK
  AI_MOVIE
}

enum BookStatus {
  DRAFT
  IN_PRODUCTION
  PUBLISHED
}

enum BookProductType {
  DIGITAL_MANUSCRIPT
  BASIC_SOFTCOVER
  CUSTOM_BOOK
}

enum BookProductionStage {
  PREPARING
  MANUSCRIPT_RECEIVED
  REVIEWING
  PROOFING
  PROOF_SENT
  PROOF_APPROVED
  PRINT_ORDERED
  PRINTING
  SHIPPING_PREPARATION
  SHIPPED
  COMPLETED
  ON_HOLD
}

enum AIBookProductionMode {
  AUTOMATIC
  CUSTOMER_REVIEW
}

enum AIBookProductionStatus {
  QUEUED
  RUNNING
  NEEDS_INPUT
  READY_FOR_APPROVAL
  APPROVED
  REJECTED
  FAILED
}

enum AIBookProductionStep {
  MATERIAL_ANALYSIS
  OUTLINE_GENERATION
  MANUSCRIPT_EDITING
  PHOTO_SELECTION
  LAYOUT_GENERATION
  QUALITY_CHECK
  FINAL_PDF
  ADMIN_APPROVAL
}

enum AIBookProductionIssueSeverity {
  INFO
  WARNING
  BLOCKER
}

enum AIBookProductionIssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum BookOrderStatus {
  READY
  PAYMENT_PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELED
  FAILED
}

enum ProductionRequestStatus {
  REQUESTED
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum CapsuleStatus {
  LOCKED
  OPENED
}

enum CustomerReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model CustomerReview {
  id              String               @id @default(cuid())
  displayName     String
  email           String
  orderReference  String?
  title           String?
  content         String
  rating          Int                  @default(5)
  status          CustomerReviewStatus @default(PENDING)
  isFeatured      Boolean              @default(false)
  isVisible       Boolean              @default(true)
  privacyAgreedAt DateTime
  approvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, isVisible, createdAt])
  @@index([isFeatured, status])
  @@index([email])
}

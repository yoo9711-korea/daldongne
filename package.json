{
  "name": "daldongne-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "brand:check": "node scripts/check-brand-name.cjs",
    "public:design-check": "node scripts/check-public-design.cjs",
    "test:flow:static": "node scripts/test-customer-flow-static.cjs",
    "test:flow:data": "node scripts/test-customer-flow-data.cjs",
    "test:flow:live": "node scripts/test-customer-flow-live.cjs",
    "test:flow:all": "pnpm test:flow:static && pnpm test:flow:data && pnpm test:flow:live",
    "test:phase2:policy": "node scripts/test-phase-two-policy.cjs",
    "test:phase2:static": "node scripts/check-phase-two-static.cjs",
    "test:phase2:data": "node scripts/check-phase-two-data.cjs",
    "test:phase2:all": "pnpm test:phase2:policy && pnpm test:phase2:static && pnpm test:phase2:data && pnpm test:flow:static",
    "test:manual-print:static": "node scripts/check-manual-print-static.cjs",
    "test:manual-print:data": "node scripts/check-manual-print-data.cjs",
    "test:manual-print:all": "pnpm test:manual-print:static && pnpm test:manual-print:data",
    "test:print-readiness:static": "node scripts/check-print-readiness-static.cjs",
    "test:print-readiness:data": "node scripts/check-print-readiness-data.cjs",
    "test:print-readiness:all": "pnpm test:print-readiness:static && pnpm test:print-readiness:data",
    "test:home-hero-buttons": "node scripts/check-home-hero-live-buttons.cjs",
    "test:payment:static": "node scripts/check-payment-system-static.cjs",
    "test:payment:data": "node scripts/check-payment-ledger-data.cjs",
    "test:payment:all": "pnpm test:payment:static && pnpm test:payment:data"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.7.4",
    "@prisma/client": "5.21.1",
    "@sparticuz/chromium": "148.0.0",
    "@tosspayments/tosspayments-sdk": "^2.7.1",
    "@vercel/blob": "^2.5.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "next": "15.5.18",
    "next-auth": "5.0.0-beta.25",
    "openai": "^6.45.0",
    "puppeteer-core": "24.43.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "resend": "^6.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "prisma": "5.21.1",
    "typescript": "5.6.3"
  }
